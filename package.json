{
  "name": "vp-next-sample",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:markup": "markuplint \"src/**/*.{html,jsx,tsx}\" --fix --problem-only",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui --pass-with-no-tests",
    "prepare": "vp config && panda codegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@praha/byethrow": "^0.11.1",
    "@praha/error-factory": "^1.4.1",
    "dataloader": "^2.2.3",
    "date-fns-tz": "^3.2.0",
    "kiso.css": "^1.2.4",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-error-boundary": "^6.1.1",
    "ts-pattern": "^5.9.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@markuplint/jsx-parser": "5.0.0-rc.4",
    "@markuplint/react-spec": "5.0.0-rc.4",
    "@pandacss/dev": "^1.10.0",
    "@pandacss/eslint-plugin": "^0.3.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-command": "^3.5.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.9.3",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-storybook": "^10.3.5",
    "markuplint": "5.0.0-rc.4",
    "msw": "^2.13.5",
    "playwright": "^1.59.1",
    "storybook": "^10.3.5",
    "typescript": "^5",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.2",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "reactDoctor": {
    "diff": true,
    "failOn": "warning",
    "files": [
      "src/**"
    ]
  }
}
